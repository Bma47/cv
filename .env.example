DB_DRIVER=postgres

# Local PostgreSQL (default for development)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=arabic_cv_builder
PGUSER=cv_builder
PGPASSWORD=replace-with-a-strong-password

# Hostinger MariaDB (set DB_DRIVER=mysql in the Web App settings)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=your_hostinger_database
MYSQL_USER=your_hostinger_database_user
MYSQL_PASSWORD=replace-with-a-strong-password

# Hostinger DB_* names are also supported. If DB_DRIVER is omitted and DB_NAME
# is present, the app automatically selects MySQL.
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=your_hostinger_database
# DB_USER=your_hostinger_database_user
# DB_PASSWORD=replace-with-a-strong-password

# Set on Hostinger to a writable directory outside the deployment build folders
CV_UPLOAD_DIR=/home/your-account/cv-uploads


